# Pima Diabetes ML + RAG + LLM — Environment Configuration
# =========================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- OpenAI ---
# Your OpenAI API key (required for LLM explanation)
OPENAI_API_KEY=

# The OpenAI model to use (e.g. gpt-4o-mini, gpt-4o)
# Leave blank — you must choose based on your account access.
OPENAI_MODEL=

# --- RAG Configuration ---
# Number of chunks to retrieve per query
TOP_K=5

# Cosine similarity threshold for retrieval (calibrated against corpus)
# A value of 0.35 is a reasonable starting point — tune after indexing.
SIMILARITY_THRESHOLD=0.35

# Document chunking parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- API Security ---
# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,null
