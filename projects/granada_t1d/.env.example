# Set these in your process/service environment; this file is not auto-loaded.
APP_PUBLIC_DEPLOYMENT=0
APP_ENABLE_RESEARCH=1
# Required when APP_PUBLIC_DEPLOYMENT=1. Use a strong, private token.
APP_ACCESS_TOKEN=
# Optional existing offline embedding cache. Never downloads a model automatically.
APP_SEMANTIC_MODEL=BAAI/bge-base-en-v1.5
# Report uploads never consume OPENAI_API_KEY implicitly.
# Supply a per-session API key only through the optional UI consent flow.
