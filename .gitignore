# Git ignore rules
# =================

# Environment — never commit secrets
.env

# ML artifacts (joblib files are large binary files)
*.joblib

# Vector store (rebuilt from source documents)
vector_store/

# Downloaded medical documents (rebuilt from registry)
data/medical_docs/*.pdf
data/medical_docs/*.txt
data/medical_docs/*.md
data/medical_docs/source_manifest.json

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
